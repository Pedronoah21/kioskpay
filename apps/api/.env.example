# Banco PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/kioskpay"

PORT=3000

# Gateway de pagamento ativo: picpay (outros adaptadores podem ser adicionados, ex.: stone)
PAYMENT_GATEWAY=picpay

# PicPay Pix — credenciais do Painel Lojista
# Homologação: https://ecommerce-api.svcp.ppay.me
# Produção:    https://ecommerce-api.svcp.picpay.com
PICPAY_BASE_URL="https://ecommerce-api.svcp.ppay.me"
PICPAY_CLIENT_ID=""
PICPAY_CLIENT_SECRET=""
# Token exibido uma única vez ao cadastrar a URL de notificação no painel
PICPAY_WEBHOOK_TOKEN=""
# Expiração do QR code em segundos (padrão do PicPay: 900)
PICPAY_PIX_EXPIRATION=900

# Recarga mínima em centavos (R$ 20,00)
RECHARGE_MIN_CENTS=2000
